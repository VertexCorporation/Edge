rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : '';
    }

    function isAdmin() {
      return isSignedIn() && userRole() == 'Yönetici';
    }

    function isMod() {
      return isSignedIn() && userRole() == 'Mod';
    }

    function isBootstrapAdmin() {
      return isSignedIn() && request.auth.token.email in [
        'rel0adneverdone@gmail.com',
        'mustawtfa@gmail.com',
        'egemen.topcuoglu6740@gmail.com',
      ];
    }

    function canManageTasks() {
      return isAdmin() || isMod() || isBootstrapAdmin();
    }

    function canDeleteGroup() {
      return isAdmin()
        || isMod()
        || resource.data.createdBy == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow create: if canManageTasks();
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow update: if canManageTasks();
    }

    match /usernames/{username} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /tasks/{taskId} {
      allow read: if isSignedIn()
        && (resource.data.assigneeId == request.auth.uid || canManageTasks());
      allow create: if canManageTasks();
      allow update: if isSignedIn()
        && (resource.data.assigneeId == request.auth.uid || canManageTasks());
      allow delete: if canManageTasks();
    }

    match /chats/{chatId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        request.resource.data.isGroup != true || isAdmin() || isMod()
      );
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && (
        resource.data.isGroup != true || canDeleteGroup()
      );
      match /messages/{messageId} {
        allow read, write: if isSignedIn();
        allow delete: if isSignedIn();
      }
    }

    match /communities/{communityId} {
      allow read, write: if isSignedIn();
    }
  }
}
